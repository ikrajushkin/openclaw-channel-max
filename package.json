{
  "name": "openclaw-channel-max",
  "version": "0.3.0",
  "description": "Канал мессенджера MAX для OpenClaw / MAX messenger channel plugin for OpenClaw",
  "type": "module",
  "license": "MIT",
  "author": "ikrajushkin",
  "homepage": "https://github.com/ikrajushkin/openclaw-channel-max#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikrajushkin/openclaw-channel-max.git"
  },
  "bugs": {
    "url": "https://github.com/ikrajushkin/openclaw-channel-max/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "channel",
    "max",
    "max-messenger",
    "chatbot"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@types/node": "^24.3.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "max",
      "label": "MAX",
      "blurb": "Подключение OpenClaw к мессенджеру MAX."
    },
    "compat": {
      "pluginApi": ">=2026.8.0",
      "minGatewayVersion": "2026.8.0"
    }
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
